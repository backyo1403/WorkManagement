# Copy this file to .env and fill in real values. Never commit .env.

# SQLite is the default local-first datastore (see prisma/schema.prisma).
# Swapping to Postgres later only requires changing DATABASE_URL and the
# `provider` line in prisma/schema.prisma — application code is unaffected.
DATABASE_URL="file:./dev.db"

# Working hours used by the deadline-risk estimate default to 9-18 on weekdays
# (see the Settings model in prisma/schema.prisma) and are editable from the
# app's Settings page afterwards — no env var needed.
