// Bach Office — data model
//
// Mirrors the behaviour proven out in bach-office.html:
//   · three fixed work groups (WORK / SPORT / LIFE) that scope every view
//   · projects own tasks, and a task always inherits its project's group
//   · subtasks carry their own optional deadline/time
//   · hashtags shared across tasks and projects
//   · per-person login, so the app can be locked and attributed
//
// SQLite keeps this local-first (no server to run). Prisma's SQLite connector
// has no enum support, so the enum-like columns below are plain strings whose
// allowed values live in src/lib/types.ts and are validated on write.
// Moving to Postgres later: change provider/url, then these can become enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── people ───────────────────────────

/// Fixed set of three (work | sport | life); seeded once, not user-editable.
/// The key doubles as the `data-group` theme attribute, so it stays lowercase.
model WorkGroup {
  key       String    @id
  name      String
  icon      String
  color     String
  sortOrder Int       @default(0)
  people    Person[]
  projects  Project[]
  tasks     Task[]
  notes     Note[]
}

model Person {
  id        String  @id @default(cuid())
  name      String
  username  String  @unique
  /// Demo-grade only: hash this before any real deployment.
  password  String
  email     String?
  phone     String?
  /// OWNER | LEAD | MEMBER
  role      String  @default("MEMBER")
  avatarUrl String?

  groupKey String
  group    WorkGroup @relation(fields: [groupKey], references: [key])

  telegramChatId String?
  zaloUserId     String?

  createdAt DateTime @default(now())

  ownedProjects   Project[]      @relation("ProjectOwner")
  createdProjects Project[]      @relation("ProjectCreator")
  assignedTasks   Task[]         @relation("TaskAssignee")
  createdTasks    Task[]         @relation("TaskCreator")
  executingTasks  TaskExecutor[]
  comments        Comment[]
  notes           Note[]

  @@index([groupKey])
}

// ─────────────────────── organising concepts ───────────────────────

model Workflow {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("folder")
  color     String   @default("#2563EB")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  tasks     Task[]
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  icon        String    @default("folder")
  color       String    @default("#2563EB")
  goal        String    @default("")
  /// NOT_STARTED | IN_PROGRESS | COMPLETED
  status      String    @default("IN_PROGRESS")
  /// ASAP | HIGH | MEDIUM | LOW
  priority    String    @default("MEDIUM")
  startDate   DateTime?
  endDate     DateTime?
  pinned      Boolean   @default(false)

  groupKey String
  group    WorkGroup @relation(fields: [groupKey], references: [key])

  ownerId   String?
  owner     Person? @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  creatorId String?
  creator   Person? @relation("ProjectCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks    Task[]
  hashtags ProjectHashtag[]
  files    ProjectFile[]
  notes    Note[]

  @@index([groupKey])
}

/// Attachment metadata only — the binary lives outside the database.
model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  url       String?
  mimeType  String?
  size      Int?
  createdAt DateTime @default(now())

  @@index([projectId])
}

// ─────────────────────────── work ───────────────────────────

model Task {
  id          String @id @default(cuid())
  title       String
  description String @default("")
  /// ASAP | HIGH | MEDIUM | LOW
  priority    String @default("MEDIUM")
  /// TODO | IN_PROGRESS | DONE
  status      String @default("TODO")

  /// Optional. A date alone is fine; only `start` puts a task on the timetable.
  deadline DateTime?
  /// Set only when an explicit clock time is chosen.
  start    DateTime?

  estimateHours Float @default(1)
  actualHours   Float @default(0)
  /// Derived, never hand-edited: 100 when DONE, else % of subtasks done, else 0.
  completion    Int   @default(0)

  pinned   Boolean @default(false)
  archived Boolean @default(false)

  /// Denormalised from the project so group filtering is one indexed lookup;
  /// kept in sync whenever the project (or the project's group) changes.
  groupKey String
  group    WorkGroup @relation(fields: [groupKey], references: [key])

  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workflowId String?
  workflow   Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   Person? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId  String?
  creator    Person? @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  subtasks  Subtask[]
  executors TaskExecutor[]
  hashtags  TaskHashtag[]
  comments  Comment[]
  activity  ActivityLog[]
  timeLogs  TimeLog[]
  noteLinks NoteTaskLink[]

  @@index([groupKey, archived])
  @@index([projectId])
  @@index([deadline])
}

/// Several people can work a task alongside the single accountable assignee.
model TaskExecutor {
  taskId   String
  personId String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([taskId, personId])
  @@index([personId])
}

model Subtask {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  text  String  @default("")
  done  Boolean @default(false)
  order Int     @default(0)

  /// Subtasks carry their own schedule; a `start` puts them on the timetable.
  deadline      DateTime?
  start         DateTime?
  estimateHours Float     @default(0.5)

  @@index([taskId])
}

// ─────────────────────────── hashtags ───────────────────────────

/// Registry of every tag ever created, so the input can autosuggest.
model Hashtag {
  id        String           @id @default(cuid())
  name      String           @unique
  createdAt DateTime         @default(now())
  tasks     TaskHashtag[]
  projects  ProjectHashtag[]
  notes     NoteHashtag[]
}

model TaskHashtag {
  taskId    String
  hashtagId String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([taskId, hashtagId])
  @@index([hashtagId])
}

model ProjectHashtag {
  projectId String
  hashtagId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([projectId, hashtagId])
  @@index([hashtagId])
}

// ─────────────────────────── notes ───────────────────────────

/// A folder for notes. `pinHash` set means the notebook is PIN-gated.
model Notebook {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("book")
  color     String   @default("#2563EB")
  sortOrder Int      @default(0)

  /// Salted SHA-256 of the PIN. This gates *access in the UI* — it is not
  /// encryption: note bodies are still stored as plain text in this database
  /// and readable by anyone with the file. See the note in README.md.
  pinHash String?
  pinSalt String?

  createdAt DateTime @default(now())
  notes     Note[]
}

model Note {
  id      String @id @default(cuid())
  title   String @default("")
  /// Markdown source. Rendered client-side; never stored as HTML.
  content String @default("")

  notebookId String?
  notebook   Notebook? @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Notes are scoped by work group like every other record.
  groupKey String
  group    WorkGroup @relation(fields: [groupKey], references: [key])

  authorId String?
  author   Person? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  favorite Boolean @default(false)
  archived Boolean @default(false)
  /// Soft delete — Trash. Purged only by an explicit permanent delete.
  deletedAt DateTime?

  /// Which built-in template seeded this note (see src/lib/note-templates.ts).
  templateKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hashtags    NoteHashtag[]
  links       NoteTaskLink[]
  attachments NoteAttachment[]
  versions    NoteVersion[]

  @@index([groupKey, archived])
  @@index([notebookId])
  @@index([projectId])
  @@index([updatedAt])
}

/// The single source of truth for the Note ↔ Task relationship.
/// Both directions read this same table, so the two views can never disagree.
model NoteTaskLink {
  noteId    String
  taskId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([noteId, taskId])
  @@index([taskId])
}

model NoteHashtag {
  noteId    String
  hashtagId String
  note      Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([noteId, hashtagId])
  @@index([hashtagId])
}

/// File metadata plus the bytes as a data URI. Small files only — see the
/// size cap enforced in the upload route.
model NoteAttachment {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String   @default("")
  size      Int      @default(0)
  dataUrl   String?
  createdAt DateTime @default(now())

  @@index([noteId])
}

/// Snapshot taken before an edit. Capped per note by the write path.
model NoteVersion {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())

  @@index([noteId, createdAt])
}

// ─────────────────────── history & tracking ───────────────────────

model Comment {
  id       String  @id @default(cuid())
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String?
  author   Person? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  text      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TimeLog {
  id      String   @id @default(cuid())
  taskId  String
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  start   DateTime
  end     DateTime
  minutes Int
  /// timer | manual | pomodoro
  source  String   @default("timer")

  @@index([taskId])
}

// ─────────────────────────── settings ───────────────────────────

/// Single row (id = 1) holding workspace-wide preferences.
model Settings {
  id Int @id @default(1)

  companyName    String @default("Bach Office")
  companyTagline String @default("Làm việc thông minh hơn")

  workStartHour Int @default(9)
  workEndHour   Int @default(18)

  /// 0 = never auto-lock.
  autoLockMinutes Int @default(15)
  /// 0 = never auto-archive completed tasks.
  autoArchiveDays Int @default(30)

  reminderDaysBefore Int    @default(2)
  reminderTime       String @default("08:00")
  reminderPerDay     Int    @default(1)

  telegramBotToken   String?
  telegramTestChatId String?
  zaloBotToken       String?
  zaloTestUserId     String?

  /// vi | en
  language String @default("vi")
  /// light | dark
  theme    String @default("light")

  /// JSON string: [{ id, w, h }] widget layout, and hidden widget ids.
  dashboardLayout String @default("[]")
  dashboardHidden String @default("[]")
}
